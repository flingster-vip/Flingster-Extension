{
  "manifest_version": 3,
  "name": "Flingster Member Access",
  "version": "1.0.0",
  "description": "Authenticate and set your member session on Flingster.",
  "permissions": ["alarms", "cookies", "storage"],
  "host_permissions": [
    "https://flingster.com/*",
    "https://www.flingster.com/*",
    "https://flingster-auth.adityabhakta2020.workers.dev/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flingster.com/*",
        "https://www.flingster.com/*"
      ],
      "css": ["flingster.css"],
      "run_at": "document_start"
    }
  ]
}